APP_NAME="Moritt API"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

# Dominio(s) del frontend permitido(s) para CORS, separados por coma.
FRONTEND_URL=http://localhost:5173

# Clave secreta de reCAPTCHA v3 (console.google.com/u/0/recaptcha-admin).
# Debe corresponder al mismo sitio que VITE_RECAPTCHA_SITE_KEY en el frontend.
RECAPTCHA_SECRET_KEY=
RECAPTCHA_MIN_SCORE=0.5

# Correo(s) que reciben las notificaciones del formulario de contacto.
# Admite varios correos separados por coma, ej: ventas@moritthermanos.com,info@pm7group.net
CONTACT_TO_EMAIL=ventas@moritthermanos.com

# Envío de correo local/desarrollo (usar "log" para no enviar de verdad,
# o smtp con un servicio de pruebas como Mailtrap).
# En producción (ver .env.production) se usa MAIL_MAILER=sendmail con el
# hosting de Webempresa, sin necesitar credenciales de ninguna casilla real.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="formulario@moritthermanos.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false
